ADMIN_KEY=

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Leave empty or set to "true" to allow all origins
# Example: "https://example.com,https://anotherdomain.com"
CORS_ORIGIN=

# Iframe Support Configuration
# Set to "true" to allow the standalone app to be embedded in iframes
# Useful for Telegram mini webapps and other iframe integrations
ALLOW_IFRAME=false

# Specify allowed frame ancestors for Content-Security-Policy
# Use space-separated values: e.g., "https://example.com https://telegram.org"
# Special values: 'self' (same origin), 'none' (no iframes), '*' (all origins)
# Example for Telegram: "https://web.telegram.org"
FRAME_ANCESTORS=